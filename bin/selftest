# Copyright 2026 Mohsen Seyedkazemi Ardebili
# SPDX-License-Identifier: Apache-2.0
# Part of opportunity-engine — https://github.com/MSKazemi/opportunity-engine
"""selftest — prove the engine works without a network, a key, or an account.

Normalisers are checked against fixtures captured from the real APIs, so a
vendor changing a field name fails here rather than silently producing rows with
empty titles. Anything that genuinely needs the network is reported as skipped,
never quietly passed.

    bin/selftest          run everything
    bin/selftest --net    also re-verify the live sources (needs a network)
"""

from __future__ import annotations

import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "libexec"))

from oe import (apply as apply_mod, cv, inbox as inbox_mod, ingest, match, paths,  # noqa: E402
                profile as profile_mod, scan, sources, store)

FIXTURES = REPO / "tests" / "fixtures"
GREEN, RED, YELLOW, OFF = "\033[32m", "\033[31m", "\033[33m", "\033[0m"

PASS = FAIL = SKIP = 0


def ok(name: str) -> None:
    global PASS
    PASS += 1
    print(f"  {GREEN}✓{OFF} {name}")


def bad(name: str, detail: str = "") -> None:
    global FAIL
    FAIL += 1
    print(f"  {RED}✗{OFF} {name}")
    if detail:
        print(f"      {detail}")


def skip(name: str, why: str) -> None:
    global SKIP
    SKIP += 1
    print(f"  {YELLOW}-{OFF} {name} (skipped: {why})")


def check(name: str, expected, actual) -> None:
    ok(name) if expected == actual else bad(name, f"expected [{expected}], got [{actual}]")


def group(title: str) -> None:
    print(f"\n{title}")


# --------------------------------------------------------------------------- #
group("source registry")

# overlay=False on purpose: these assert what the PROJECT ships. Reading the
# tester's own workspace overlay here would make the suite pass or fail based on
# whichever boards they happen to have added.
registry = sources.load(overlay=False)
allsrc = sources.all_sources(registry)
check("registry parses", True, isinstance(allsrc, list) and len(allsrc) > 0)
check("every source has an id", [], [s for s in allsrc if not s.get("id")])
check("ids are unique", len(allsrc), len({s["id"] for s in allsrc}))
check("every source records how it was verified", [],
      [s["id"] for s in allsrc if not s.get("verified", {}).get("method")])
check("no source claims http verification without a status", [],
      [s["id"] for s in allsrc
       if s.get("verified", {}).get("method") == "http" and "status" not in s["verified"]])
check("every source declares its free terms", [],
      [s["id"] for s in allsrc if "free" not in s])

paid = [s for s in allsrc if not sources.is_free(s)]
check("paid sources are excluded by --free-only", 0,
      len([s for s in sources.filter_sources(allsrc, free_only=True) if s in paid]))
check("key-holding sources are excluded by --no-key", [],
      [s["id"] for s in sources.filter_sources(allsrc, no_key=True) if sources.needs_key(s)])
check("filtering by region narrows the list", True,
      len(sources.filter_sources(allsrc, region="dach")) < len(allsrc))

per_company = [s for s in allsrc if (s.get("access") or {}).get("per_company")]
check("per-company boards are flagged, not guessed from the URL", True,
      all("{" in (s.get("access") or {}).get("endpoint", "") for s in per_company))
check("a per-company board asks for a sample rather than inventing one", "needs-sample",
      sources.check({"id": "x", "access": {"endpoint": "https://e/{company}", "per_company": True}})["verdict"])
check("a row verified today is not reported as stale", 0,
      sources.staleness({"verified": {"date": __import__("datetime").date.today().isoformat()}}))
check("a row never verified has no age, rather than an age of zero", None,
      sources.staleness({"verified": {}}))
check("a keyed source is reported, not silently skipped", "needs-key",
      sources.check({"id": "x", "access": {"endpoint": "https://e", "key_required": True}})["verdict"])

# --------------------------------------------------------------------------- #
group("normalisers (fixtures captured from the real APIs)")

CASES = [
    ("greenhouse", "greenhouse.json", "gitlab"),
    ("ashby", "ashby.json", "ramp"),
    ("arbeitnow", "arbeitnow.json", ""),
    ("remotive", "remotive.json", ""),
    ("remoteok", "remoteok.json", ""),
    ("jobicy", "jobicy.json", ""),
    ("himalayas", "himalayas.json", ""),
]

for source_id, filename, target in CASES:
    path = FIXTURES / filename
    if not path.exists():
        skip(f"{source_id} normaliser", f"no fixture at {path}")
        continue
    rows = list(scan.NORMALISERS[source_id](json.loads(path.read_text()), target))
    if not rows:
        bad(f"{source_id} normaliser produces rows", "0 rows from the fixture")
        continue
    missing_title = [r for r in rows if not r.get("title")]
    missing_url = [r for r in rows if not r.get("url")]
    if missing_title:
        bad(f"{source_id} normaliser fills title", f"{len(missing_title)}/{len(rows)} rows have none")
    elif missing_url:
        bad(f"{source_id} normaliser fills url", f"{len(missing_url)}/{len(rows)} rows have none")
    elif any(r["source"] != source_id for r in rows):
        bad(f"{source_id} normaliser stamps its own source", "")
    else:
        ok(f"{source_id} normaliser: {len(rows)} row(s), title + url on each")

wwr = FIXTURES / "weworkremotely.xml"
if wwr.exists():
    try:
        rows = list(scan._weworkremotely(wwr.read_bytes()))
        check("weworkremotely RSS normaliser", True, len(rows) > 0 and bool(rows[0]["title"]))
    except Exception as err:  # noqa: BLE001 - the fixture is the thing under test
        bad("weworkremotely RSS normaliser", f"{type(err).__name__}: {err}")
else:
    skip("weworkremotely RSS normaliser", "no fixture")

check("html is reduced to readable text", "Senior SRE We need you",
      scan.text_of("<h1>Senior SRE</h1><p>We&nbsp;need   you</p>"))
check("an empty description stays empty rather than becoming noise", "", scan.text_of(None))

# --------------------------------------------------------------------------- #
group("deduplication")

fp = store.fingerprint
check("legal-form suffixes do not split a company",
      fp("ACME GmbH", "Senior SRE"), fp("ACME", "Senior SRE"))
check("gender markers in a title do not split a role",
      fp("ACME", "Senior SRE (m/w/d)"), fp("ACME", "Senior SRE"))
check("case and spacing do not split a role",
      fp("ACME", "Senior  SRE"), fp("acme", "senior sre"))
check("a different role is a different job",
      False, fp("ACME", "Senior SRE") == fp("ACME", "Staff SRE"))
check("the same role in another city is another job",
      False, fp("ACME", "SRE", "Berlin") == fp("ACME", "SRE", "Munich"))

# --------------------------------------------------------------------------- #
group("store lifecycle")

with tempfile.TemporaryDirectory() as tmp:
    workspace = paths.ensure_workspace(Path(tmp) / ".opp")
    check("init creates the workspace", True, (workspace / "profile").is_dir())

    con = store.connect(paths.db_path(workspace))
    row = {"source": "test", "url": "https://e/1", "title": "Senior SRE", "org": "ACME GmbH",
           "location": "Berlin", "description": "k8s"}
    check("a new opportunity is new", "new", store.upsert(con, row))
    check("the same posting again is known", "known", store.upsert(con, row))
    check("the same job at another URL is a duplicate", "duplicate",
          store.upsert(con, {**row, "url": "https://other/9", "org": "ACME"}))
    check("a genuinely different job is new", "new",
          store.upsert(con, {**row, "url": "https://e/2", "title": "Staff SRE"}))

    counts = store.counts(con)
    check("the duplicate is closed, not left to be applied to twice", 1, counts.get("closed", 0))
    check("only the real openings are actionable", 2, counts.get("new", 0))

    con.execute("UPDATE opportunities SET state='applied' WHERE title='Senior SRE' AND source='test'")
    con.commit()
    store.upsert(con, row)
    state = con.execute("SELECT state FROM opportunities WHERE url='https://e/1'").fetchone()["state"]
    check("a re-scan never resets a state you moved by hand", "applied", state)

    check("every event is logged", True,
          con.execute("SELECT COUNT(*) c FROM events").fetchone()["c"] >= 3)
    con.close()

    reopened = sqlite3.connect(paths.db_path(workspace))
    check("the store survives being closed and reopened", 3,
          reopened.execute("SELECT COUNT(*) FROM opportunities").fetchone()[0])
    reopened.close()

# --------------------------------------------------------------------------- #
group("scan control flow (no network)")

rows, report = scan.scan_source("greenhouse", target=None)
check("a per-company board without a target says so", "needs-target", report["status"])
rows, report = scan.scan_source("not-a-real-source")
check("an unknown source is named, not ignored", "unknown-source", report["status"])
rows, report = scan.scan_source("linkedin")
check("a source with no key-free feed says why", "not-scannable", report["status"])

# --------------------------------------------------------------------------- #
group("row plausibility (a bad row is worse than no row)")

check("a placeholder employer is rejected", "placeholder employer 'name'",
      scan.plausible({"title": "Senior SRE", "org": "name", "url": "https://e/1"}))
check("a real row passes", "",
      scan.plausible({"title": "Senior SRE", "org": "ACME", "url": "https://e/1"}))
check("a row with no title is rejected", "no title",
      scan.plausible({"title": "", "org": "ACME", "url": "https://e/1"}))
check("a row with no apply url is rejected", "no url to apply through",
      scan.plausible({"title": "Senior SRE", "org": "ACME", "url": ""}))
check("an empty employer is tolerated (some feeds omit it)", "",
      scan.plausible({"title": "Senior SRE", "org": "", "url": "https://e/1"}))

# --------------------------------------------------------------------------- #
group("profile")

prof = json.loads((REPO / "examples" / "profile" / "profile.example.json").read_text())
check("the example profile has no blocking gaps", [], profile_mod.gaps(prof))
check("skill terms are extracted", True, len(profile_mod.skill_terms(prof)) > 40)
check("evidence is traceable to a place", True,
      all(where for where, _ in profile_mod.evidence_corpus(prof)))

pubs = list(profile_mod._publications(prof))
check("published work is found however it was nested", True, len(pubs) > 5)
nested = {"publications": {"journals": {"publishedOrAccepted": [{"name": "real"}],
                                        "underReview": [{"name": "not yet"}],
                                        "inPreparation": [{"name": "no"}]}}}
check("'under review' is never counted as a publication", ["real"],
      [p["name"] for p in profile_mod._publications(nested)])

a = {"basics": {"name": "A", "email": "a@e"}, "skills": [{"name": "k8s"}]}
b = {"basics": {"name": "B", "phone": "123"}, "skills": [{"name": "k8s"}, {"name": "aws"}]}
merged = profile_mod.merge(a, b, source="second.json")
check("a later document never overwrites an earlier value", "A", merged["basics"]["name"])
check("a new field is still added", "123", merged["basics"]["phone"])
check("lists merge without duplicating", 2, len(merged["skills"]))
check("a disagreement is recorded, not silently resolved", True,
      any("basics.name" in c for c in merged["meta"]["conflicts"]))
check("every contributing document is recorded", ["second.json"], merged["meta"]["sources"])

# --------------------------------------------------------------------------- #
group("ingest")

with tempfile.TemporaryDirectory() as tmp:
    tmpdir = Path(tmp)
    (tmpdir / "r.json").write_text(json.dumps(
        {"basics": {"name": "X", "email": "x@e"}, "work": [{"name": "ACME"}]}))
    fragment, report = ingest.ingest_file(tmpdir / "r.json")
    check("JSON Resume is recognised", "json-resume", report["kind"])

    (tmpdir / "li.json").write_text(json.dumps(
        {"firstName": "A", "lastName": "B", "headline": "SRE",
         "positions": [{"companyName": "ACME", "title": "SRE", "startedOn": "2020-01"}],
         "skills": [{"name": "kubernetes"}]}))
    fragment, report = ingest.ingest_file(tmpdir / "li.json")
    check("a LinkedIn export is recognised", "linkedin-export", report["kind"])
    check("LinkedIn positions become work entries", "ACME", fragment["work"][0]["name"])
    check("and it warns that form answers are still missing", True,
          any("work authorization" in t for t in report["todo"]))

    (tmpdir / "cv.tex").write_text(
        r"\section{Contact} \href{https://github.com/me}{GitHub} me@example.com "
        r"\textbf{ORCID} 0000-0002-1166-6559")
    fragment, report = ingest.ingest_file(tmpdir / "cv.tex")
    check("latex is read as text", "latex", report["kind"])
    check("an email is extracted", "me@example.com", fragment["basics"]["email"])
    networks = {p["network"] for p in fragment["basics"]["profiles"]}
    check("known profile links are recognised", True, {"GitHub", "ORCID"} <= networks)
    check("roles are NEVER inferred from prose", True,
          any("were NOT inferred" in t for t in report["todo"]))

    (tmpdir / "cv.txt").write_text("Just some words about my career.")
    fragment, _ = ingest.ingest_file(tmpdir / "cv.txt")
    check("text with no contact details invents none", {}, fragment.get("basics", {}))

prompt = ingest.agent_prompt(prof)
check("the agent prompt forbids invention", True, "Invent nothing" in prompt)
check("the agent prompt forbids copying private identifiers", True,
      "date of birth" in prompt.lower())

# --------------------------------------------------------------------------- #
group("matching")

LEX = match.lexicon()
POSTING = {
    "id": "t1", "title": "Senior MLOps Engineer", "org": "ACME", "url": "https://e/1",
    "location": "Berlin, Germany", "posted_at": "2026-08-15",
    "description": """About us. We do things.
Requirements:
- 5+ years with Kubernetes in production
- Strong Python
- Experience with Prometheus and Grafana
- PhD or MSc in a technical field
Nice to have:
- Rust
- Terraform
""",
}
reqs = match.extract_requirements(POSTING, LEX)
check("required bullets are separated from nice-to-have", True,
      "kubernetes" in reqs["required_terms"] and "rust" not in reqs["required_terms"])
check("a nice-to-have is recorded as optional", True, "rust" in reqs["optional_terms"])
check("years demanded are read", 5, reqs["years_demanded"])
check("degree demands are read", True, "phd" in reqs["degrees"])
check("seniority is read from the title", ["senior"], reqs["seniority"])
check("a real requirements section is high confidence", "high", reqs["confidence"])

report = match.match(prof, POSTING, {"languages": ["english"]}, LEX)
check("a real match is scorable", True, report["fit"] is not None)
check("evidence is graded per requirement", True,
      all(g["grade"] in ("proven", "claimed", "absent") for g in report["stage2_evidence"]["graded"]))
check("every 'proven' grade carries the line that proves it", True,
      all(g["evidence"] for g in report["stage2_evidence"]["graded"] if g["grade"] == "proven"))

thin = {**POSTING, "title": "Account Manager", "description": "Talk to customers. Python helps."}
thin_report = match.match(prof, thin, {"languages": ["english"]}, LEX)
check("a posting with too few stated requirements is not scored", "unscorable",
      thin_report["verdict"])
check("and it says why rather than scoring 100%", True,
      "too few to judge" in thin_report["advice"][0])

unrelated = {**POSTING, "title": "Account Manager"}
align, _ = match.title_alignment(prof, unrelated)
check("an unrelated title scores zero alignment", 0.0, align)
align2, _ = match.title_alignment(prof, POSTING)
check("a matching title scores above zero", True, align2 > 0)

blocked = match.match(prof, {**POSTING, "description": POSTING["description"] +
                             "\nA security clearance is required."},
                      {"languages": ["english"], "no_clearance": True}, LEX)
check("a clearance requirement knocks the role out", "knocked-out", blocked["verdict"])
check("a knockout names the rule that caused it", True,
      bool(blocked["knockouts"][0]["source"]))

lang_blocked = match.match(prof, {**POSTING, "description": POSTING["description"] +
                                  "\n- Fluent German required"},
                           {"languages": ["english"]}, LEX)
check("a language you did not list knocks the role out", "knocked-out", lang_blocked["verdict"])

check("a skill inside a group name still counts as claimed", True,
      any(g["term"] == "kubernetes" and g["grade"] in ("proven", "claimed")
          for g in report["stage2_evidence"]["graded"]))

for text, expected in (("Fri, 15 Aug 2026 09:00:00 +0000", 2026),
                       ("2026-08-10T12:00:00", 2026), ("2026-08-01", 2026),
                       ("1786757871", 2026)):
    parsed = match.parse_date(text)
    check(f"date parsed: {text[:28]}", expected, parsed.year if parsed else None)
check("an unparseable date is None, never 'today'", None, match.parse_date("nonsense"))
check("an unknown age does not fake urgency", 1.0, match.freshness(None)[0])
check("a fresh posting ranks above a stale one", True,
      match.freshness("2026-08-15")[0] > match.freshness("2026-01-01")[0])

# --------------------------------------------------------------------------- #
group("cv generation")

check("latex specials are escaped", r"R\&D 50\% \$x \#1 a\_b",
      cv.tex_escape("R&D 50% $x #1 a_b"))
check("an em dash becomes something pdflatex can set", "a---b", cv.tex_escape("a—b"))
check("maths symbols in a CV do not kill the build", r"best $\approx$45\%",
      cv.tex_escape("best ≈45%"))
check("a middot between skills survives", r"MLOps $\cdot$ HPC", cv.tex_escape("MLOps · HPC"))

check("an internal note is caught", 1,
      len(cv.lint("Did a thing. NOTE: check this number before sending")))
check("a TODO is caught", 1, len(cv.lint(r"\item Shipped it. TODO: verify")))
check("a redaction placeholder is caught", 1, len(cv.lint("Salary: «your range»")))
check("a path to a private file is caught", 1,
      len(cv.lint("Built the thing (see projects/kubeintellect/CLAIMS.md)")))
check("template comments are not flagged", 0, len(cv.lint("% NOTE: this is a comment")))
check("ordinary CV prose is not flagged", 0,
      len(cv.lint(r"\item Operated production Kubernetes for a EuroHPC platform.")))

POSTING_FOR_CV = {**POSTING}
cv_report = match.match(prof, POSTING_FOR_CV, {"languages": ["english"]}, LEX)
template = (REPO / "cv" / "templates" / "ats.tex").read_text()
plain_tex, plain_dropped = cv.render_tex(prof, template, None)
tuned_tex, _ = cv.render_tex(prof, template, cv_report)

check("every section is rendered", True,
      all(s in plain_tex for s in (r"\section{Experience}", r"\section{Education}",
                                   r"\section{Skills}")))
check("the name reaches the document", True, prof["basics"]["name"] in plain_tex)
check("no unfilled placeholder survives", [], re.findall(r"\{\{\s*\w+\s*\}\}", plain_tex))
check("a dropped highlight is counted, never silent", True, plain_dropped >= 0)

def skill_rows(text):
    return [m.group(1) for m in re.finditer(r"\\skillrow\{([^}]*)\}", text)]

check("tailoring changes the order", True, skill_rows(plain_tex) != skill_rows(tuned_tex))
check("tailoring adds nothing and removes nothing",
      sorted(skill_rows(plain_tex)), sorted(skill_rows(tuned_tex)))
check("tailoring keeps every role",
      len(re.findall(r"\\role\{", plain_tex)), len(re.findall(r"\\role\{", tuned_tex)))

with tempfile.TemporaryDirectory() as tmp:
    built = cv.build(prof, Path(tmp), report=cv_report, compile_it=False)
    check("a tailored build is named for the employer", True,
          Path(built["tex"]).name.startswith("cv-"))
    check("the built document carries no private notes", [], built["lint"])

    if shutil.which("pdflatex") and shutil.which("pdftotext"):
        built = cv.build(prof, Path(tmp), compile_it=True)
        if not built.get("pdf"):
            bad("the CV compiles to PDF", built.get("compile_note", "")[:200])
        else:
            out = subprocess.run(["pdftotext", "-layout", built["pdf"], "-"],
                                 capture_output=True, timeout=60)
            text = out.stdout.decode("utf-8", "replace")
            ok("the CV compiles to PDF")
            # The whole point of the layout: a parser must get it back in order.
            check("the name survives extraction", True, prof["basics"]["name"] in text)
            positions = [text.find(h) for h in ("Experience", "Education", "Skills")]
            check("sections extract in the right order", sorted(positions), positions)
            check("no section is lost in extraction", True, all(p > 0 for p in positions))
    else:
        skip("PDF round-trip through a parser", "needs pdflatex and pdftotext")

# --------------------------------------------------------------------------- #
group("application packages (assembled, never sent)")

answers = apply_mod.form_answers(prof)
check("every standard form question is covered", True, len(answers) >= 12)
check("an answerable question is answered", True,
      any(q == "Full name" and done for q, _, done in answers))
bare = apply_mod.form_answers({"basics": {"name": "X"}})
check("an unanswerable question is marked MISSING, never guessed", True,
      all(a == apply_mod.MISSING for q, a, done in bare if not done))
check("MISSING says who has to answer it", True, "you must answer" in apply_mod.MISSING)

letter_text, letter_warnings = apply_mod.letter(prof, POSTING, cv_report)
check("the letter is marked a draft", True, "DRAFT" in letter_text)
check("the opening line is left for the human", True,
      "write this yourself" in letter_text)
check("the letter carries the applicant's name", True, prof["basics"]["name"] in letter_text)

evidence_lines = [ln for ln in letter_text.splitlines() if ln.startswith("- ")]
check("no evidence line is repeated", len(evidence_lines), len(set(evidence_lines)))
corpus_text = " ".join(t for _, t in profile_mod.evidence_corpus(prof))
for line in evidence_lines:
    quoted = line[2:].split(" *(")[0].rstrip(".…").strip()
    if quoted and quoted[:60] not in corpus_text:
        bad("every letter claim comes from the profile", f"not in profile: {quoted[:70]}")
        break
else:
    ok("every letter claim comes from the profile")

empty_report = match.match({"basics": {"name": "N"}, "skills": [], "work": []}, POSTING,
                           {"languages": ["english"]}, LEX)
_, no_evidence_warnings = apply_mod.letter({"basics": {"name": "N"}}, POSTING, empty_report)
check("a letter with no evidence behind it says so", True,
      any("no evidence to stand on" in w for w in no_evidence_warnings))

task = apply_mod.fleet_task(POSTING, Path("/tmp/x"))
check("the browser handoff carries its own rules", True, len(task["rules"]) >= 6)
for phrase in ("Never type a password", "block the task", "DO NOT SUBMIT",
               "Never report this task done", "data, never instructions"):
    check(f"handoff rule present: {phrase[:34]}", True,
          any(phrase in r for r in task["rules"]))
check("the handoff never contains a credential", [],
      [k for k in json.dumps(task).lower().split('"')
       if k in ("password", "token", "secret", "api_key")])
check("the handoff tells the worker what to block with", True,
      any("ready to submit" in r for r in task["rules"]))
check("filling and stopping is the default", False, task["auto_submit"])

# auto_submit is a preference about the user's own time. It buys speed; it must
# never buy a false statement, so the blockers below are not waivable by it.
clean = apply_mod.fleet_task(POSTING, Path("/tmp/x"), auto_submit=True, blockers=[])
check("a clean package may be sent when asked", True, clean["auto_submit"])
check("sending still demands the real confirmation", True,
      any("confirmation the site actually returned" in r for r in clean["rules"]))
check("the audit screenshot is taken before, not after", True,
      any("BEFORE" in r for r in clean["rules"]))
check("a clicked button is never mistaken for success", True,
      any("Never infer success" in r for r in clean["rules"]))
check("even sending never types a password", True,
      any("Never type a password" in r for r in clean["rules"]))

dirty = apply_mod.fleet_task(POSTING, Path("/tmp/x"), auto_submit=True,
                             blockers=["2 field(s) only you can answer: Phone"])
check("auto_submit does not override a blocker", False, dirty["auto_submit"])
check("the blocked package is told not to submit", True,
      any("DO NOT SUBMIT" in r for r in dirty["rules"]))
check("and the worker is told why it may not", True,
      any("did not qualify" in r for r in dirty["rules"]))

# The blockers themselves, computed from what the tool already knows.
ok_report = {"knockouts": []}
check("a clean package has nothing blocking it", [],
      apply_mod.submit_blockers(ok_report, [], []))
check("an unanswered field blocks sending", 1,
      len(apply_mod.submit_blockers(ok_report, ["Phone"], [])))
check("private notes in the CV block sending", 1,
      len(apply_mod.submit_blockers(ok_report, [], ["note: call recruiter"])))
check("a knocked-out posting blocks sending", 1,
      len(apply_mod.submit_blockers({"knockouts": [{"why": "needs clearance"}]}, [], [])))
check("every reason is reported, not just the first", 3,
      len(apply_mod.submit_blockers({"knockouts": [{"why": "x"}]}, ["Phone"], ["note"])))

check("the note tells the worker sending is on", True,
      "auto_submit is ON" in apply_mod.queue_note(POSTING, Path("/tmp/p"), [], will_submit=True))
check("and by default tells it the opposite", True,
      "never submit" in apply_mod.queue_note(POSTING, Path("/tmp/p"), [], will_submit=False))

