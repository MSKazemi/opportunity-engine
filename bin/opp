# Part of opportunity-engine — https://github.com/MSKazemi/opportunity-engine
"""opp — the command line for opportunity-engine.

    opp init                 make this directory a workspace
    opp sources              what can be searched, and what it costs
    opp scan                 pull opportunities from the key-free sources
    opp list                 what is in the workspace
    opp doctor               is this set up to actually work

Everything writes to the workspace, never to the installed copy.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "libexec"))

from oe import (__version__, apply as apply_mod, cv, ingest, match,  # noqa: E402
                paths, profile as profile_mod, scan, sources, store)

GREEN, RED, YELLOW, DIM, OFF = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def emit(rows: list[dict], as_json: bool) -> None:
    if as_json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))


# --------------------------------------------------------------------------- #

def cmd_init(args) -> int:
    root = Path(args.path).resolve() if args.path else Path.cwd()
    workspace = paths.ensure_workspace(root / paths.WORKSPACE_MARKER)
    print(f"workspace: {workspace}")
    store.connect(paths.db_path(workspace)).close()
    print(f"store:     {paths.db_path(workspace)}")

    config = paths.config_path(workspace)
    if not config.exists():
        config.write_text(json.dumps(paths.DEFAULT_CONFIG, indent=2) + "\n")
    print(f"rules:     {config}  {DIM}(your hard limits — nothing is assumed for you){OFF}")
    profile = paths.profile_path(workspace)
    if not profile.exists():
        print(f"\nNo profile yet. The engine can find work without one, but it cannot")
        print(f"match or apply. Create it from whatever you already have:")
        print(f"  opp ingest path/to/cv.pdf path/to/resume.json ...")
    return 0


def cmd_ingest(args) -> int:
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2

    existing = profile_mod.load()
    base = existing if existing is not None else profile_mod.empty()
    try:
        merged, reports = ingest.ingest([Path(p) for p in args.files], base)
    except ingest.IngestError as err:
        print(f"ingest failed: {err}", file=sys.stderr)
        return 2

    for report in reports:
        print(f"  {report['file']}  [{report['kind']}]")
        for item in report["extracted"]:
            print(f"      {GREEN}+{OFF} {item}")
        for item in report["todo"]:
            print(f"      {YELLOW}?{OFF} {item}")

    where = profile_mod.save(merged)
    print(f"\nprofile: {where}")

    conflicts = merged.get("meta", {}).get("conflicts", [])
    if conflicts:
        print(f"{YELLOW}{len(conflicts)} conflict(s) — the first value was kept, nothing overwritten:{OFF}")
        for line in conflicts[:5]:
            print(f"  {line}")

    remaining = profile_mod.gaps(merged)
    if remaining:
        print(f"\n{YELLOW}still missing before you can apply honestly:{OFF}")
        for field, why in remaining:
            print(f"  {field:<45} {DIM}{why}{OFF}")
        print(f"\n{DIM}fill them in {where}, or: opp profile --agent{OFF}")
    else:
        print(f"\n{GREEN}complete enough to apply{OFF} · next: opp match --top 20")
    return 0


def cmd_profile(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile yet — run: opp ingest <your cv and any json you have>", file=sys.stderr)
        return 2
    if args.agent:
        print(ingest.agent_prompt(loaded))
        return 0
    if args.json:
        print(json.dumps(loaded, indent=2, ensure_ascii=False))
        return 0

    info = profile_mod.summarise(loaded)
    print(f"{info['name']}   {DIM}{info['label']}{OFF}")
    print(f"  {info['roles']} role(s) · {info['skills']} skill group(s) · "
          f"{info['projects']} project(s) · {info['publications']} publication(s)")
    print(f"  {info['skill_terms']} claimable term(s) · {info['evidence_items']} evidence item(s)")
    if info["sources"]:
        print(f"  built from: {', '.join(Path(s).name for s in info['sources'])}")
    if info["conflicts"]:
        print(f"\n{YELLOW}conflicts (first value kept):{OFF}")
        for line in info["conflicts"][:8]:
            print(f"  {line}")
    if info["gaps"]:
        print(f"\n{YELLOW}gaps that block an application:{OFF}")
        for field, why in info["gaps"]:
            print(f"  {field:<45} {DIM}{why}{OFF}")
    else:
        print(f"\n{GREEN}no blocking gaps{OFF}")
    return 0


def _print_match(report: dict, verbose: bool) -> None:
    colour = {"strong": GREEN, "plausible": YELLOW, "weak": DIM,
              "knocked-out": RED, "unscorable": DIM}[report["verdict"]]
    fit = "  – " if report["fit"] is None else f"{report['fit']:.2f}"
    print(f"\n{colour}{report['verdict'].upper()}{OFF}  fit {fit}   {report['title']}")
    print(f"  {report['org']}  ·  {report['url']}")

    for block in report["knockouts"]:
        print(f"  {RED}blocked{OFF}  {block['kind']}: {block['why']}  {DIM}({block['source']}){OFF}")

    s1, s2 = report["stage1_parser"], report["stage2_evidence"]
    if s1["score"] is not None:
        print(f"  stage 1 (parser gate)   {s1['score']:.0%} of required terms present"
              f"   {DIM}{len(s1['covered'])} covered, {len(s1['missing'])} missing{OFF}")
    if s2["score"] is not None:
        print(f"  stage 2 (ranking layer) {s2['score']:.0%} supported"
              f"   {DIM}{s2['proven']} proven, {s2['claimed']} claimed only, {s2['absent']} absent{OFF}")

    sentence = report["defensible_sentence"]
    mark = f"{GREEN}✓{OFF}" if sentence["ok"] else f"{YELLOW}!{OFF}"
    print(f"  {mark} categorisable: {DIM}{sentence['note']}{OFF}")

    if verbose:
        for graded in report["stage2_evidence"]["graded"]:
            if graded["grade"] == "proven":
                print(f"      {GREEN}proven{OFF}  {graded['term']:<22} {DIM}{graded['where']}: "
                      f"{graded['evidence'][:90]}{OFF}")
            elif graded["grade"] == "claimed":
                print(f"      {YELLOW}claimed{OFF} {graded['term']:<22} {DIM}skills list only{OFF}")
    for line in report["advice"]:
        print(f"  → {line}")


def cmd_match(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile — run: opp ingest <files>", file=sys.stderr)
        return 2
    constraints = paths.load_config()
    lex = match.lexicon()
    con = store.connect(paths.db_path())

    if args.id:
        row = con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()
        if row is None:
            print(f"no opportunity {args.id}", file=sys.stderr)
            return 2
        rows = [row]
    else:
        rows = list(con.execute(
            "SELECT * FROM opportunities WHERE state IN ('new','screened') "
            "ORDER BY posted_at DESC LIMIT ?", (args.scan_limit,)))

    if not rows:
        print("nothing to match — run: opp scan")
        return 0

    reports = []
    for row in rows:
        report = match.match(loaded, dict(row), constraints, lex)
        reports.append(report)
        con.execute(
            "UPDATE opportunities SET score = ?, score_detail = ?, state = ?, "
            "state_reason = ?, updated_at = ? WHERE id = ?",
            (report["priority"], json.dumps(report, ensure_ascii=False)[:60000],
             "rejected" if report["verdict"] == "knocked-out" else "screened",
             (report["knockouts"][0]["why"] if report["knockouts"] else ""),
             store.now(), row["id"]))
        store.log(con, row["id"], "matched", report["verdict"])
    con.commit()

    ranked = sorted([r for r in reports if r["priority"] is not None],
                    key=lambda r: r["priority"], reverse=True)
    blocked = [r for r in reports if r["verdict"] == "knocked-out"]

    if args.json:
        print(json.dumps(ranked, indent=2, ensure_ascii=False))
        con.close()
        return 0

    shown = [r for r in ranked if r["verdict"] != "knocked-out"][:args.top]
    for report in shown:
        _print_match(report, args.verbose)

    worth = [r for r in shown if r["fit"] and r["fit"] >= constraints["min_fit"]]
    print(f"\n{len(reports)} scored · {len(worth)} above your min_fit of "
          f"{constraints['min_fit']} · {len(blocked)} knocked out")
    if blocked and args.verbose:
        print(f"\n{DIM}knocked out:{OFF}")
        for report in blocked[:10]:
            print(f"  {report['title'][:50]:<50} {report['knockouts'][0]['why']}")
    con.close()
    return 0


def cmd_cv(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile — run: opp ingest <files>", file=sys.stderr)
        return 2

    report = None
    if args.__dict__.get("for_id"):
        con = store.connect(paths.db_path())
        row = con.execute("SELECT * FROM opportunities WHERE id = ?",
                          (args.for_id,)).fetchone()
        con.close()
        if row is None:
            print(f"no opportunity {args.for_id}", file=sys.stderr)
            return 2
        report = match.match(loaded, dict(row), paths.load_config(), match.lexicon())
        if report["verdict"] == "knocked-out":
            print(f"{YELLOW}note{OFF}: this role is knocked out "
                  f"({report['knockouts'][0]['why']}). Building anyway, since you asked.")

    out = Path(args.out) if args.out else (paths.find_workspace() / "cv")
    try:
        result = cv.build(loaded, out, variant=args.variant, report=report,
                          compile_it=not args.no_pdf)
    except FileNotFoundError as err:
        print(f"{err}", file=sys.stderr)
        return 2

    print(f"  tex: {result['tex']}")
    if result.get("highlights_dropped"):
        print(f"  {DIM}{result['highlights_dropped']} highlight(s) beyond 6 per role were left "
              f"out to keep this readable — the ones kept are the most relevant.{OFF}")
    if result.get("lint"):
        print(f"\n  {RED}this document contains text that looks like private notes:{OFF}")
        for problem in result["lint"][:8]:
            print(f"    {problem}")
        print(f"  {DIM}Fix it in your profile before sending this to anyone.{OFF}")
    if result.get("pdf"):
        print(f"  pdf: {result['pdf']}")
    elif result.get("compile_note"):
        print(f"  {YELLOW}pdf not built{OFF}: {result['compile_note'].splitlines()[0]}")
    if report:
        print(f"\n  tailored for: {result['tailored_for']}")
        print(f"  {DIM}Order changed only. Nothing was added to your profile, and nothing "
              f"in this document is a claim your profile does not already make.{OFF}")
        weak = report.get("unsupported_claims") or []
        if weak:
            print(f"  {YELLOW}listed but not demonstrated anywhere{OFF}: {', '.join(weak[:8])}")
            print(f"  {DIM}A reader who asks about these will find nothing behind them.{OFF}")
    return 0


def cmd_apply(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile — run: opp ingest <files>", file=sys.stderr)
        return 2
    workspace = paths.find_workspace()
    constraints = paths.load_config()
    lex = match.lexicon()
    con = store.connect(paths.db_path(workspace))

    if args.id:
        rows = [con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()]
        if rows[0] is None:
            print(f"no opportunity {args.id}", file=sys.stderr)
            return 2
    else:
        rows = list(con.execute(
            "SELECT * FROM opportunities WHERE state = 'screened' AND score IS NOT NULL "
            "ORDER BY score DESC LIMIT ?", (args.top,)))
    if not rows:
        print("nothing to prepare — run: opp match", file=sys.stderr)
        return 2

    prepared = 0
    for row in rows:
        posting = dict(row)
        report = match.match(loaded, posting, constraints, lex)
        if report["verdict"] == "knocked-out" and not args.force:
            print(f"  {RED}skipped{OFF} {posting['title'][:46]:<46} "
                  f"{report['knockouts'][0]['why']}")
            continue
        if (report["fit"] or 0) < constraints["min_fit"] and not args.force:
            print(f"  {DIM}skipped{OFF} {posting['title'][:46]:<46} "
                  f"below your min_fit of {constraints['min_fit']}")
            continue

        result = apply_mod.build_package(loaded, posting, report, workspace,
                                         with_pdf=not args.no_pdf)
        prepared += 1
        print(f"\n{GREEN}prepared{OFF} {posting['title']}")
        print(f"  {result['package']}")
        print(f"  {DIM}posting.md · letter.md · form-answers.md · "
              f"{Path(result['cv']['tex']).name}"
              f"{' · ' + Path(result['cv']['pdf']).name if result['cv'].get('pdf') else ''}"
              f" · fleet-task.json{OFF}")

        for warning in result["letter_warnings"]:
            print(f"  {YELLOW}!{OFF} {warning}")
        if result["cv_lint"]:
            print(f"  {RED}!{OFF} the CV contains text that looks like private notes:")
            for problem in result["cv_lint"][:4]:
                print(f"      {problem}")
        if result["unanswered"]:
            print(f"  {YELLOW}{len(result['unanswered'])} form field(s) only you can answer{OFF}: "
                  f"{', '.join(result['unanswered'][:5])}")

        con.execute("UPDATE opportunities SET state = 'drafted', updated_at = ? WHERE id = ?",
                    (store.now(), posting["id"]))
        store.log(con, posting["id"], "drafted", result["package"])
    con.commit()
    con.close()

    if prepared:
        print(f"\n{prepared} package(s) prepared. {RED}Nothing has been sent.{OFF}")
        print(f"{DIM}Read each one, write the opening line of the letter yourself, then submit."
              f"\nAfterwards record it with the confirmation you actually saw:"
              f"\n  opp applied <id> --evidence \"confirmation #12345 shown on screen\"{OFF}")
    return 0


def cmd_applied(args) -> int:
    """Record a real submission. Evidence is not optional here."""
    con = store.connect(paths.db_path())
    row = con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()
    if row is None:
        print(f"no opportunity {args.id}", file=sys.stderr)
        return 2
    con.execute("UPDATE opportunities SET state = ?, state_reason = ?, updated_at = ? WHERE id = ?",
                ("blocked" if args.blocked else "applied", args.evidence, store.now(), args.id))
    store.log(con, args.id, "blocked" if args.blocked else "applied", args.evidence)
    con.commit()
    con.close()
    verb = "blocked" if args.blocked else "applied"
    print(f"{GREEN}{verb}{OFF}  {row['title']}  —  {args.evidence}")
    return 0


def cmd_sources(args) -> int:
    registry = sources.load()
    rows = sources.filter_sources(
        sources.all_sources(registry),
        free_only=args.free_only, kind=args.kind, region=args.region,
        opportunity_type=args.type, no_key=args.no_key,
        automatable=True if args.automatable else None)

    if args.json:
        emit(rows, True)
        return 0

    print(f"{len(rows)} source(s)   registry updated {registry['updated']}\n")
    for source in rows:
        free = source.get("free", {})
        capacity = free.get("capacity")
        period = free.get("capacity_period")
        if capacity is None:
            allowance = "no published cap"
        elif capacity == 0:
            allowance = "cannot apply on the free tier"
        else:
            allowance = f"{capacity}/{period}"

        stale = sources.staleness(source)
        method = source.get("verified", {}).get("method", "?")
        if method == "http":
            mark = f"{GREEN}verified{OFF}"
        elif method in ("operator", "documented"):
            mark = f"{YELLOW}{method}{OFF}"
        else:
            mark = f"{RED}unverified{OFF}"
        age = f"{stale}d ago" if stale is not None else "never"

        scannable = "scan" if source["id"] in scan.SCANNABLE else "    "
        print(f"  {source['id']:<18} {scannable}  {source['kind']:<22} {allowance:<28} {mark} ({age})")
        if args.long:
            print(f"      {DIM}{source['name']} — {', '.join(source.get('opportunity_types', []))}"
                  f" · {', '.join(source.get('regions', []))}{OFF}")
            if source.get("why_it_matters"):
                print(f"      {DIM}{source['why_it_matters']}{OFF}")
    print(f"\n{DIM}'scan' = has a key-free feed this tool can read directly."
          f" The rest need a browser and a human-held login.{OFF}")
    return 0


def cmd_sources_check(args) -> int:
    registry = sources.load()
    targets = ([sources.get(args.id, registry)] if args.id
               else sources.all_sources(registry))
    targets = [t for t in targets if t]
    if not targets:
        print(f"no such source: {args.id}", file=sys.stderr)
        return 2

    bad = 0
    for source in targets:
        result = sources.check(source, sample=args.sample, timeout=args.timeout)
        verdict = result["verdict"]
        colour = {"ok": GREEN, "http-error": RED, "unreachable": RED}.get(verdict, DIM)
        detail = result.get("note") or f"HTTP {result.get('status')} · {result.get('bytes')} bytes"
        print(f"  {colour}{verdict:<13}{OFF} {source['id']:<18} {detail}")
        if verdict in ("http-error", "unreachable"):
            bad += 1
    print(f"\n{len(targets)} checked, {bad} failing")
    return 1 if bad else 0


def cmd_scan(args) -> int:
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2
    con = store.connect(paths.db_path(workspace))

    registry = sources.load()
    if args.source:
        wanted = [(args.source, args.target)]
    else:
        # Everything with a key-free feed that is not a per-company board. The
        # per-company ones need `--source greenhouse --target <company>`, because
        # "every Greenhouse board on earth" is not a thing anyone can enumerate.
        free_feeds = [s["id"] for s in sources.filter_sources(
            sources.all_sources(registry), free_only=True, no_key=True)
            if s["id"] in scan.SCANNABLE and not (s.get("access") or {}).get("per_company")]
        wanted = [(sid, None) for sid in free_feeds]

    totals = {"new": 0, "duplicate": 0, "known": 0}
    for source_id, target in wanted:
        rows, report = scan.scan_source(source_id, target, limit=args.limit, registry=registry)
        outcomes = {"new": 0, "duplicate": 0, "known": 0}
        for row in rows:
            outcomes[store.upsert(con, row)] += 1
        for key in totals:
            totals[key] += outcomes[key]
        con.commit()
        store.record_scan(con, source=source_id, target=target or "",
                          status=report["status"], fetched=report.get("fetched", 0),
                          new_rows=outcomes["new"], duplicates=outcomes["duplicate"],
                          detail=report.get("detail", ""))
        con.commit()

        if report["status"] == "ok":
            line = (f"  {GREEN}ok{OFF}    {source_id:<16} {report['fetched']:>4} fetched  "
                    f"{outcomes['new']:>4} new  {outcomes['duplicate']:>3} dup  "
                    f"{outcomes['known']:>4} already seen")
            if report.get("rejected"):
                line += f"  {YELLOW}{report['rejected']} dropped{OFF}"
            print(line)
            # Never let a silent drop look like a quiet source.
            if report.get("rejected"):
                print(f"        {DIM}{report.get('detail', '')}{OFF}")
        else:
            print(f"  {RED}{report['status']}{OFF}  {source_id:<16} {report.get('detail', '')[:80]}")

    print(f"\n{totals['new']} new opportunit(ies), {totals['duplicate']} same job under another URL")
    if totals["new"]:
        print("next:  opp list --state new")
    con.close()
    return 0


def cmd_list(args) -> int:
    con = store.connect(paths.db_path())
    rows = store.search(con, state=args.state, source=args.source,
                        limit=args.limit, order=args.order)
    if args.json:
        print(store.dump(rows))
        return 0
    if not rows:
        print("nothing here yet — run: opp scan")
        return 0
    for row in rows:
        score = f"{row['score']:.2f}" if row["score"] is not None else "  – "
        remote = "remote" if row["remote"] else (row["location"] or "")[:22]
        print(f"  {row['id']}  {score}  {row['state']:<11} {(row['org'] or '?')[:26]:<26} "
              f"{row['title'][:44]:<44} {DIM}{remote}{OFF}")
    print(f"\n{len(rows)} shown · {DIM}opp show <id>{OFF}")
    con.close()
    return 0


def cmd_show(args) -> int:
    con = store.connect(paths.db_path())
    row = con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()
    if row is None:
        print(f"no opportunity {args.id}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(dict(row), indent=2, ensure_ascii=False))
        return 0
    print(f"{row['title']}\n{row['org']}  ·  {row['location'] or '—'}  ·  {row['source']}")
    print(f"{row['url']}\n")
    print(f"state: {row['state']}   posted: {row['posted_at'] or '—'}")
    if row["salary_min"]:
        print(f"pay:   {row['salary_min']:.0f}–{row['salary_max'] or 0:.0f} "
              f"{row['salary_currency']} / {row['salary_period'] or '?'}")
    body = row["description"] or "(no description came with this posting)"
    print("\n" + (body if args.full else body[:1200] + ("…" if len(body) > 1200 else "")))
    con.close()
    return 0


def cmd_doctor(args) -> int:
    problems: list[str] = []
    workspace = paths.find_workspace()
    print(f"workspace: {workspace}{'' if workspace.exists() else '  (not created — run opp init)'}")
    if not workspace.exists():
        problems.append("no workspace")

    profile = paths.profile_path(workspace)
    print(f"profile:   {'present' if profile.exists() else 'missing — scan works, match and apply do not'}")
    if not profile.exists():
        problems.append("no profile")

    registry = sources.load()
    allsrc = sources.all_sources(registry)
    free = [s for s in allsrc if sources.is_free(s)]
    scannable = [s for s in allsrc if s["id"] in scan.SCANNABLE]
    stale = [s for s in allsrc
             if (sources.staleness(s) or 10**6) > sources.STALE_DAYS]
    print(f"sources:   {len(allsrc)} known · {len(free)} free · {len(scannable)} directly scannable")
    if stale:
        print(f"           {YELLOW}{len(stale)} row(s) unverified for over {sources.STALE_DAYS} days"
              f"{OFF} — re-check with: opp sources check")

    if workspace.exists():
        con = store.connect(paths.db_path(workspace))
        counts = store.counts(con)
        total = sum(counts.values())
        print(f"store:     {total} opportunit(ies) " +
              (", ".join(f"{k}={v}" for k, v in sorted(counts.items())) if counts else ""))
        con.close()

    if problems:
        print(f"\n{YELLOW}not ready:{OFF} " + ", ".join(problems))
        return 1
    print(f"\n{GREEN}ready{OFF}")
    return 0


# --------------------------------------------------------------------------- #

def main() -> int:
    parser = argparse.ArgumentParser(prog="opp", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"opportunity-engine {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="make a workspace here")
    p.add_argument("path", nargs="?")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("ingest", help="fold a CV, a resume.json or any document into your profile")
    p.add_argument("files", nargs="+")
    p.set_defaults(func=cmd_ingest)

    p = sub.add_parser("profile", help="what your profile can claim, and what is missing")
    p.add_argument("--agent", action="store_true",
                   help="print a prompt for a Claude session to complete it (no API call)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_profile)

    p = sub.add_parser("match", help="score opportunities against your profile, with evidence")
    p.add_argument("--id", help="one opportunity")
    p.add_argument("--top", type=int, default=10, help="how many to print")
    p.add_argument("--scan-limit", type=int, default=300, help="how many to score")
    p.add_argument("--verbose", "-v", action="store_true", help="show the evidence per requirement")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_match)

    p = sub.add_parser("cv", help="build a parser-safe CV from your profile")
    p.add_argument("--for", dest="for_id", help="tailor the ORDER for one opportunity id")
    p.add_argument("--variant", default="ats")
    p.add_argument("--out", help="output directory (default: the workspace)")
    p.add_argument("--no-pdf", action="store_true", help="write .tex only")
    p.set_defaults(func=cmd_cv)

    p = sub.add_parser("apply", help="assemble application packages (it never submits)")
    p.add_argument("--id", help="one opportunity")
    p.add_argument("--top", type=int, default=5, help="how many of the best matches")
    p.add_argument("--force", action="store_true",
                   help="prepare even a knocked-out or low-fit role")
    p.add_argument("--no-pdf", action="store_true")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("applied", help="record a submission you actually made")
    p.add_argument("id")
    p.add_argument("--evidence", required=True,
                   help="the confirmation the system returned — required, and not a formality")
    p.add_argument("--blocked", action="store_true", help="record a wall instead of a submission")
    p.set_defaults(func=cmd_applied)

    p = sub.add_parser("sources", help="where opportunities can be found, and what each costs")
    p.add_argument("--free-only", action="store_true", help="only what needs no card")
    p.add_argument("--no-key", action="store_true", help="only what needs no API key")
    p.add_argument("--kind")
    p.add_argument("--region")
    p.add_argument("--type", help="employment, freelance, contract, grant, …")
    p.add_argument("--automatable", action="store_true")
    p.add_argument("--long", "-l", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_sources)

    p = sub.add_parser("sources-check", help="re-verify sources by actually calling them")
    p.add_argument("--id")
    p.add_argument("--sample", help="company slug for a per-company board")
    p.add_argument("--timeout", type=int, default=30)
    p.set_defaults(func=cmd_sources_check)

    p = sub.add_parser("scan", help="pull opportunities from the key-free sources")
    p.add_argument("--source", help="one source id (default: every key-free feed)")
    p.add_argument("--target", help="company slug, for a per-company board")
    p.add_argument("--limit", type=int, default=200)
    p.set_defaults(func=cmd_scan)

    p = sub.add_parser("list", help="what is in the workspace")
    p.add_argument("--state", help=f"one of: {', '.join(store.STATES)}")
    p.add_argument("--source")
    p.add_argument("--limit", type=int, default=40)
    p.add_argument("--order", default="score", choices=("score", "date", "org"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show", help="one opportunity in full")
    p.add_argument("id")
    p.add_argument("--full", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("doctor", help="is this set up to actually work")
    p.set_defaults(func=cmd_doctor)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
