"""opp — the command line for opportunity-engine.

    opp init                 make this directory a workspace
    opp sources              what can be searched, and what it costs
    opp scan                 pull opportunities from the key-free sources
    opp list                 what is in the workspace
    opp doctor               is this set up to actually work

Everything writes to the workspace, never to the installed copy.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "libexec"))

from oe import (__version__, apply as apply_mod, cv, inbox as inbox_mod,  # noqa: E402
                ingest, match, paths, profile as profile_mod, scan, sources, store)

GREEN, RED, YELLOW, DIM, OFF = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def emit(rows: list[dict], as_json: bool) -> None:
    if as_json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))


# --------------------------------------------------------------------------- #

def cmd_init(args) -> int:
    root = Path(args.path).resolve() if args.path else Path.cwd()
    workspace = paths.ensure_workspace(root / paths.WORKSPACE_MARKER)
    print(f"workspace: {workspace}")
    store.connect(paths.db_path(workspace)).close()
    print(f"store:     {paths.db_path(workspace)}")

    config = paths.config_path(workspace)
    if not config.exists():
        config.write_text(json.dumps(paths.DEFAULT_CONFIG, indent=2) + "\n")
    print(f"rules:     {config}  {DIM}(your hard limits — nothing is assumed for you){OFF}")

    local = paths.local_sources_path(workspace)
    if not local.exists():
        local.write_text(json.dumps(paths.DEFAULT_LOCAL_SOURCES, indent=2) + "\n")
    print(f"sources:   {local}  {DIM}(your own boards, merged over the shipped registry){OFF}")
    profile = paths.profile_path(workspace)
    if not profile.exists():
        print(f"\nNo profile yet. The engine can find work without one, but it cannot")
        print(f"match or apply. Create it from whatever you already have:")
        print(f"  opp ingest path/to/cv.pdf path/to/resume.json ...")
    return 0


def cmd_ingest(args) -> int:
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2

    existing = profile_mod.load()
    base = existing if existing is not None else profile_mod.empty()
    try:
        merged, reports = ingest.ingest([Path(p) for p in args.files], base)
    except ingest.IngestError as err:
        print(f"ingest failed: {err}", file=sys.stderr)
        return 2

    for report in reports:
        print(f"  {report['file']}  [{report['kind']}]")
        for item in report["extracted"]:
            print(f"      {GREEN}+{OFF} {item}")
        for item in report["todo"]:
            print(f"      {YELLOW}?{OFF} {item}")

    where = profile_mod.save(merged)
    print(f"\nprofile: {where}")

    conflicts = merged.get("meta", {}).get("conflicts", [])
    if conflicts:
        print(f"{YELLOW}{len(conflicts)} conflict(s) — the first value was kept, nothing overwritten:{OFF}")
        for line in conflicts[:5]:
            print(f"  {line}")

    remaining = profile_mod.gaps(merged)
    if remaining:
        print(f"\n{YELLOW}still missing before you can apply honestly:{OFF}")
        for field, why in remaining:
            print(f"  {field:<45} {DIM}{why}{OFF}")
        print(f"\n{DIM}fill them in {where}, or: opp profile --agent{OFF}")
    else:
        print(f"\n{GREEN}complete enough to apply{OFF} · next: opp match --top 20")
    return 0


def cmd_profile(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile yet — run: opp ingest <your cv and any json you have>", file=sys.stderr)
        return 2
    if args.agent:
        print(ingest.agent_prompt(loaded))
        return 0
    if args.json:
        print(json.dumps(loaded, indent=2, ensure_ascii=False))
        return 0

    info = profile_mod.summarise(loaded)
    print(f"{info['name']}   {DIM}{info['label']}{OFF}")
    print(f"  {info['roles']} role(s) · {info['skills']} skill group(s) · "
          f"{info['projects']} project(s) · {info['publications']} publication(s)")
    print(f"  {info['skill_terms']} claimable term(s) · {info['evidence_items']} evidence item(s)")
    if info["sources"]:
        print(f"  built from: {', '.join(Path(s).name for s in info['sources'])}")
    if info["conflicts"]:
        print(f"\n{YELLOW}conflicts (first value kept):{OFF}")
        for line in info["conflicts"][:8]:
            print(f"  {line}")
    if info["gaps"]:
        print(f"\n{YELLOW}gaps that block an application:{OFF}")
        for field, why in info["gaps"]:
            print(f"  {field:<45} {DIM}{why}{OFF}")
    else:
        print(f"\n{GREEN}no blocking gaps{OFF}")
    return 0


def _print_match(report: dict, verbose: bool) -> None:
    colour = {"strong": GREEN, "plausible": YELLOW, "weak": DIM,
              "knocked-out": RED, "unscorable": DIM}[report["verdict"]]
    fit = "  – " if report["fit"] is None else f"{report['fit']:.2f}"
    print(f"\n{colour}{report['verdict'].upper()}{OFF}  fit {fit}   {report['title']}")
    print(f"  {report['org']}  ·  {report['url']}")

    for block in report["knockouts"]:
        print(f"  {RED}blocked{OFF}  {block['kind']}: {block['why']}  {DIM}({block['source']}){OFF}")

    s1, s2 = report["stage1_parser"], report["stage2_evidence"]
    if s1["score"] is not None:
        print(f"  stage 1 (parser gate)   {s1['score']:.0%} of required terms present"
              f"   {DIM}{len(s1['covered'])} covered, {len(s1['missing'])} missing{OFF}")
    if s2["score"] is not None:
        print(f"  stage 2 (ranking layer) {s2['score']:.0%} supported"
              f"   {DIM}{s2['proven']} proven, {s2['claimed']} claimed only, {s2['absent']} absent{OFF}")

    sentence = report["defensible_sentence"]
    mark = f"{GREEN}✓{OFF}" if sentence["ok"] else f"{YELLOW}!{OFF}"
    print(f"  {mark} categorisable: {DIM}{sentence['note']}{OFF}")

    if verbose:
        for graded in report["stage2_evidence"]["graded"]:
            if graded["grade"] == "proven":
                print(f"      {GREEN}proven{OFF}  {graded['term']:<22} {DIM}{graded['where']}: "
                      f"{graded['evidence'][:90]}{OFF}")
            elif graded["grade"] == "claimed":
                print(f"      {YELLOW}claimed{OFF} {graded['term']:<22} {DIM}skills list only{OFF}")
    for line in report["advice"]:
        print(f"  → {line}")


def cmd_match(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile — run: opp ingest <files>", file=sys.stderr)
        return 2
    constraints = paths.load_config()
    lex = match.lexicon()
    con = store.connect(paths.db_path())

    if args.id:
        row = con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()
        if row is None:
            print(f"no opportunity {args.id}", file=sys.stderr)
            return 2
        rows = [row]
    else:
        rows = list(con.execute(
            "SELECT * FROM opportunities WHERE state IN ('new','screened') "
            "ORDER BY posted_at DESC LIMIT ?", (args.scan_limit,)))

    if not rows:
        print("nothing to match — run: opp scan")
        return 0

    reports = []
    for row in rows:
        report = match.match(loaded, dict(row), constraints, lex)
        reports.append(report)
        con.execute(
            "UPDATE opportunities SET score = ?, score_detail = ?, state = ?, "
            "state_reason = ?, updated_at = ? WHERE id = ?",
            (report["priority"], json.dumps(report, ensure_ascii=False)[:60000],
             "rejected" if report["verdict"] == "knocked-out" else "screened",
             (report["knockouts"][0]["why"] if report["knockouts"] else ""),
             store.now(), row["id"]))
        store.log(con, row["id"], "matched", report["verdict"])
    con.commit()

    ranked = sorted([r for r in reports if r["priority"] is not None],
                    key=lambda r: r["priority"], reverse=True)
    blocked = [r for r in reports if r["verdict"] == "knocked-out"]

    if args.json:
        print(json.dumps(ranked, indent=2, ensure_ascii=False))
        con.close()
        return 0

    shown = [r for r in ranked if r["verdict"] != "knocked-out"][:args.top]
    for report in shown:
        _print_match(report, args.verbose)

    worth = [r for r in shown if r["fit"] and r["fit"] >= constraints["min_fit"]]
    print(f"\n{len(reports)} scored · {len(worth)} above your min_fit of "
          f"{constraints['min_fit']} · {len(blocked)} knocked out")
    if blocked and args.verbose:
        print(f"\n{DIM}knocked out:{OFF}")
        for report in blocked[:10]:
            print(f"  {report['title'][:50]:<50} {report['knockouts'][0]['why']}")
    con.close()
    return 0


def cmd_cv(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile — run: opp ingest <files>", file=sys.stderr)
        return 2

    report = None
    if args.__dict__.get("for_id"):
        con = store.connect(paths.db_path())
        row = con.execute("SELECT * FROM opportunities WHERE id = ?",
                          (args.for_id,)).fetchone()
        con.close()
        if row is None:
            print(f"no opportunity {args.for_id}", file=sys.stderr)
            return 2
        report = match.match(loaded, dict(row), paths.load_config(), match.lexicon())
        if report["verdict"] == "knocked-out":
            print(f"{YELLOW}note{OFF}: this role is knocked out "
                  f"({report['knockouts'][0]['why']}). Building anyway, since you asked.")

    out = Path(args.out) if args.out else (paths.find_workspace() / "cv")
    try:
        result = cv.build(loaded, out, variant=args.variant, report=report,
                          compile_it=not args.no_pdf)
    except FileNotFoundError as err:
        print(f"{err}", file=sys.stderr)
        return 2

    print(f"  tex: {result['tex']}")
    if result.get("highlights_dropped"):
        print(f"  {DIM}{result['highlights_dropped']} highlight(s) beyond 6 per role were left "
              f"out to keep this readable — the ones kept are the most relevant.{OFF}")
    if result.get("lint"):
        print(f"\n  {RED}this document contains text that looks like private notes:{OFF}")
        for problem in result["lint"][:8]:
            print(f"    {problem}")
        print(f"  {DIM}Fix it in your profile before sending this to anyone.{OFF}")
    if result.get("pdf"):
        print(f"  pdf: {result['pdf']}")
    elif result.get("compile_note"):
        print(f"  {YELLOW}pdf not built{OFF}: {result['compile_note'].splitlines()[0]}")
    if report:
        print(f"\n  tailored for: {result['tailored_for']}")
        print(f"  {DIM}Order changed only. Nothing was added to your profile, and nothing "
              f"in this document is a claim your profile does not already make.{OFF}")
        weak = report.get("unsupported_claims") or []
        if weak:
            print(f"  {YELLOW}listed but not demonstrated anywhere{OFF}: {', '.join(weak[:8])}")
            print(f"  {DIM}A reader who asks about these will find nothing behind them.{OFF}")
    return 0


def cmd_apply(args) -> int:
    loaded = profile_mod.load()
    if loaded is None:
        print("no profile — run: opp ingest <files>", file=sys.stderr)
        return 2
    workspace = paths.find_workspace()
    constraints = paths.load_config()
    lex = match.lexicon()
    con = store.connect(paths.db_path(workspace))

    if args.id:
        rows = [con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()]
        if rows[0] is None:
            print(f"no opportunity {args.id}", file=sys.stderr)
            return 2
    else:
        rows = list(con.execute(
            "SELECT * FROM opportunities WHERE state = 'screened' AND score IS NOT NULL "
            "ORDER BY score DESC LIMIT ?", (args.top,)))
    if not rows:
        print("nothing to prepare — run: opp match", file=sys.stderr)
        return 2

    # Config is the standing policy; the flag overrides it for this run only.
    auto_submit = (constraints.get("auto_submit", False)
                   if args.auto_submit is None else args.auto_submit)
    send_budget = int(constraints.get("auto_submit_max", 10)) if auto_submit else 0
    if auto_submit:
        print(f"{RED}auto-submit is ON{OFF} — up to {send_budget} application(s) may be sent "
              f"without you seeing them first.")
        print(f"{DIM}Packages that cannot be sent truthfully are prepared and left waiting "
              f"anyway.{OFF}\n")

    prepared = 0
    will_send = 0
    queue_entries = []
    for row in rows:
        posting = dict(row)
        report = match.match(loaded, posting, constraints, lex)
        if report["verdict"] == "knocked-out" and not args.force:
            print(f"  {RED}skipped{OFF} {posting['title'][:46]:<46} "
                  f"{report['knockouts'][0]['why']}")
            continue
        if (report["fit"] or 0) < constraints["min_fit"] and not args.force:
            print(f"  {DIM}skipped{OFF} {posting['title'][:46]:<46} "
                  f"below your min_fit of {constraints['min_fit']}")
            continue

        # The cap is spent per package actually cleared to send, not per package
        # prepared — otherwise a run of blocked ones would exhaust it silently.
        result = apply_mod.build_package(loaded, posting, report, workspace,
                                         with_pdf=not args.no_pdf,
                                         auto_submit=auto_submit and will_send < send_budget)
        prepared += 1
        if result["will_submit"]:
            will_send += 1
        queue_entries.append(result["queue_entry"])
        print(f"\n{GREEN}prepared{OFF} {posting['title']}")
        print(f"  {result['package']}")
        print(f"  {DIM}posting.md · letter.md · form-answers.md · "
              f"{Path(result['cv']['tex']).name}"
              f"{' · ' + Path(result['cv']['pdf']).name if result['cv'].get('pdf') else ''}"
              f" · fleet-task.json{OFF}")

        for warning in result["letter_warnings"]:
            print(f"  {YELLOW}!{OFF} {warning}")
        if result["cv_lint"]:
            print(f"  {RED}!{OFF} the CV contains text that looks like private notes:")
            for problem in result["cv_lint"][:4]:
                print(f"      {problem}")
        if result["unanswered"]:
            print(f"  {YELLOW}{len(result['unanswered'])} form field(s) only you can answer{OFF}: "
                  f"{', '.join(result['unanswered'][:5])}")

        if result["will_submit"]:
            print(f"  {RED}→ this one will be SENT without you seeing it{OFF}")
        elif auto_submit:
            reason = (result["submit_blockers"][0] if result["submit_blockers"]
                      else f"the run's cap of {send_budget} is spent")
            print(f"  {DIM}→ waits for you: {reason}{OFF}")

        con.execute("UPDATE opportunities SET state = 'drafted', updated_at = ? WHERE id = ?",
                    (store.now(), posting["id"]))
        store.log(con, posting["id"], "drafted", result["package"])
    con.commit()
    con.close()

    if prepared and will_send:
        # `opp` itself still sends nothing — but saying "nothing has been sent"
        # while handing workers permission to send would be true of this process
        # and false about what is now in motion.
        print(f"\n{prepared} package(s) prepared. {RED}{will_send} of them will be SENT{OFF} "
              f"by a worker, without a further look from you.")
        print(f"{DIM}Not started yet — they go out when the fleet runs. To stop it: "
              f"delete the queued tasks, or re-run with --no-auto-submit.{OFF}")
    elif prepared:
        print(f"\n{prepared} package(s) prepared. {RED}Nothing has been sent.{OFF}")

    if prepared and args.fleet:
        # A posting with no URL has no page to fill; queueing it would put a
        # task in the browser lane that no worker can act on.
        routable = [e for e in queue_entries if e["url"].startswith(("http://", "https://"))]
        skipped = len(queue_entries) - len(routable)
        outcome = apply_mod.enqueue(routable, workspace)

        if outcome["method"] == "fleet":
            print(f"\n{GREEN}queued{OFF} {outcome['queued']} task(s) for agent-fleet "
                  f"{DIM}in {outcome['path']}{OFF}")
            print(f"{DIM}Workers fill the form and stop. Every one lands in 'blocked'"
                  f"\nawaiting you — that is the design, not a failure."
                  f"\n  cd {workspace} && fleet plan     # how many terminals this deserves"
                  f"\n  cd {workspace} && fleet run"
                  f"\n  cd {workspace} && fleet blocked  # what is ready for your review{OFF}")
        elif outcome["method"] == "batch-file":
            print(f"\n{YELLOW}fleet is not installed{OFF} — wrote {outcome['queued']} task(s) to")
            print(f"  {outcome['path']}")
            print(f"{DIM}Install agent-fleet, then:"
                  f"\n  cd {workspace} && fleet add-batch {apply_mod.BATCH_FILE} "
                  f"--kind {apply_mod.QUEUE_KIND}{OFF}")

        if skipped:
            print(f"  {YELLOW}!{OFF} {skipped} package(s) not queued: the posting records no URL")
        for failure in outcome["failed"]:
            print(f"  {RED}!{OFF} could not queue {failure['title']}: {failure['why']}")

    if prepared:
        print(f"\n{DIM}Read each one, write the opening line of the letter yourself, then submit."
              f"\nAfterwards record it with the confirmation you actually saw:"
              f"\n  opp applied <id> --evidence \"confirmation #12345 shown on screen\"{OFF}")
    return 0


def cmd_applied(args) -> int:
    """Record a real submission. Evidence is not optional here."""
    con = store.connect(paths.db_path())
    row = con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()
    if row is None:
        print(f"no opportunity {args.id}", file=sys.stderr)
        return 2
    con.execute("UPDATE opportunities SET state = ?, state_reason = ?, updated_at = ? WHERE id = ?",
                ("blocked" if args.blocked else "applied", args.evidence, store.now(), args.id))
    store.log(con, args.id, "blocked" if args.blocked else "applied", args.evidence)
    con.commit()
    con.close()
    verb = "blocked" if args.blocked else "applied"
    print(f"{GREEN}{verb}{OFF}  {row['title']}  —  {args.evidence}")
    return 0


def cmd_inbox(args) -> int:
    """Find the confirmations that arrived by email for applications already sent."""
    workspace = paths.find_workspace()
    con = store.connect(paths.db_path(workspace))
    targets = inbox_mod.awaiting(con, window_days=args.days)
    con.close()

    if not targets:
        print(f"{DIM}nothing is awaiting confirmation in the last {args.days} day(s).{OFF}")
        print(f"{DIM}Applications appear here once `opp apply` has prepared them and nothing "
              f"has been recorded as sent.{OFF}")
        return 0

    scope = inbox_mod.search_scope(targets)
    print(f"{len(targets)} application(s) awaiting confirmation\n")
    for t in targets:
        print(f"  {t['id']}  {t.get('org','?')[:24]:<24} {t.get('title','?')[:40]:<40} "
              f"{DIM}{', '.join(t['senders']) or 'no domain resolved'}{OFF}")

    # Anyone about to let an agent near their mail should see the boundary first.
    print(f"\n{YELLOW}what a reconciler would be allowed to read{OFF}")
    print(f"  after       {scope['after']}")
    print(f"  from        {', '.join(scope['from_domains']) or '(none resolved)'}")
    print(f"  or subject  {', '.join(scope['subject_any_of'][:6]) or '(none)'}")
    print(f"  {DIM}nothing else in the mailbox is opened, and nothing is ever replied to,"
          f"\n  labelled, archived or deleted. Links are never clicked — activation links and"
          f"\n  one-time codes stay with you.{OFF}")

    if not args.fleet:
        print(f"\n{DIM}to have an agent do it:  opp inbox --fleet{OFF}")
        return 0

    task = inbox_mod.reconcile_task(targets)
    note = (f"Read {workspace}/.opp inbox-check task. " + " ".join(task["rules"][:3]))
    outcome = apply_mod.enqueue([{
        "url": task["title"],          # agent-lane tasks carry text, not a URL
        "title": task["title"],
        "note": note,
        "priority": 4,
        "kind": inbox_mod.QUEUE_KIND,
        "exec": "agent",
    }], workspace)

    spec = workspace / "inbox-check.json"
    spec.write_text(json.dumps(task, indent=2, ensure_ascii=False))
    print(f"\n{GREEN}queued{OFF} 1 reconciler in the {DIM}agent{OFF} lane "
          f"{DIM}(no terminal, no Chrome tab){OFF}")
    print(f"  full scope and rules: {spec}")
    if outcome["method"] == "batch-file":
        print(f"  {YELLOW}fleet is not installed{OFF} — written to {outcome['path']}")
    for failure in outcome["failed"]:
        print(f"  {RED}!{OFF} {failure['why']}")
    return 0


def cmd_sources(args) -> int:
    registry = sources.load()
    rows = sources.filter_sources(
        sources.all_sources(registry, include_disabled=True),
        free_only=args.free_only, kind=args.kind, region=args.region,
        opportunity_type=args.type, no_key=args.no_key,
        automatable=True if args.automatable else None)
    if args.local:
        rows = [s for s in rows if s.get("_origin") in ("local", "patched")]

    if args.json:
        emit(rows, True)
        return 0

    print(f"{len(rows)} source(s)   registry updated {registry['updated']}\n")
    for source in rows:
        free = source.get("free", {})
        capacity = free.get("capacity")
        period = free.get("capacity_period")
        if capacity is None:
            allowance = "no published cap"
        elif capacity == 0:
            allowance = "cannot apply on the free tier"
        else:
            allowance = f"{capacity}/{period}"

        stale = sources.staleness(source)
        method = source.get("verified", {}).get("method", "?")
        if method == "http":
            mark = f"{GREEN}verified{OFF}"
        elif method in ("operator", "documented"):
            mark = f"{YELLOW}{method}{OFF}"
        else:
            mark = f"{RED}unverified{OFF}"
        age = f"{stale}d ago" if stale is not None else "never"

        # Where the row came from, so a number you are about to trust can always
        # be traced to whoever asserted it — the project, or you.
        origin = source.get("_origin", "shipped")
        badge = {"local": f"{YELLOW}+local{OFF}", "patched": f"{YELLOW}~patched{OFF}"}.get(origin, "")
        if sources.is_disabled(source):
            badge = f"{DIM}off{OFF}"

        scannable = "scan" if source["id"] in scan.SCANNABLE else "    "
        name = f"{DIM}{source['id']}{OFF}" if sources.is_disabled(source) else source["id"]
        pad = " " * max(0, 18 - len(source["id"]))
        print(f"  {name}{pad} {scannable}  {source['kind']:<22} {allowance:<28} "
              f"{mark} ({age}) {badge}")
        if args.long:
            print(f"      {DIM}{source['name']} — {', '.join(source.get('opportunity_types', []))}"
                  f" · {', '.join(source.get('regions', []))}{OFF}")
            if source.get("why_it_matters"):
                print(f"      {DIM}{source['why_it_matters']}{OFF}")
    print(f"\n{DIM}'scan' = has a key-free feed this tool can read directly."
          f" The rest need a browser and a human-held login.{OFF}")
    mine = [s for s in rows if s.get("_origin") in ("local", "patched")]
    if mine:
        print(f"{DIM}+local / ~patched come from {paths.local_sources_path()}{OFF}")
    return 0


def cmd_sources_add(args) -> int:
    """Add, patch, mute or drop a row in the workspace's own source list.

    A command rather than "edit the JSON" because this file is meant to be
    written by an agent as often as by a person, and a half-written registry is
    worse than no registry: every later scan reads it.
    """
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2

    local_file = paths.local_sources_path(workspace)
    try:
        local = json.loads(local_file.read_text())
    except (OSError, ValueError):
        local = dict(paths.DEFAULT_LOCAL_SOURCES)
    rows = local.setdefault("sources", [])

    existing = next((r for r in rows if r.get("id") == args.id), None)
    shipped = sources.get(args.id, sources.load(overlay=False))

    if args.remove:
        if existing is None:
            print(f"nothing of yours to remove for '{args.id}'"
                  + (" — it is a shipped source, so `--disable` is what mutes it"
                     if shipped else ""), file=sys.stderr)
            return 2
        rows.remove(existing)
        local_file.write_text(json.dumps(local, indent=2, ensure_ascii=False) + "\n")
        restored = " — the shipped row is back in force" if shipped else ""
        print(f"{GREEN}removed{OFF} your entry for {args.id}{restored}")
        return 0

    row: dict = dict(existing) if existing else {"id": args.id}
    access: dict = dict(row.get("access") or {})

    if args.endpoint:
        access["endpoint"] = args.endpoint
        access.setdefault("method", "api")
        access.setdefault("auth", "none")
        access.setdefault("key_required", False)
    if args.per_company:
        access["per_company"] = True
    if args.max_rows is not None:
        access["max_rows"] = args.max_rows
    if access:
        row["access"] = access

    if args.name:
        row["name"] = args.name
    if args.kind:
        row["kind"] = args.kind
    if args.note:
        row["_why"] = args.note
    if args.disable:
        row["disabled"] = True
    if args.enable:
        row.pop("disabled", None)
        if not shipped and len(row) == 1:
            print(f"'{args.id}' is not a source you have — nothing to enable", file=sys.stderr)
            return 2

    if not shipped and "access" not in row and not args.disable:
        print(f"'{args.id}' is new, so it needs somewhere to look: pass --endpoint",
              file=sys.stderr)
        return 2

    if existing:
        rows[rows.index(existing)] = row
    else:
        rows.append(row)
    local_file.write_text(json.dumps(local, indent=2, ensure_ascii=False) + "\n")

    verb = "patched" if shipped else ("updated" if existing else "added")
    print(f"{GREEN}{verb}{OFF} {args.id}  {DIM}→ {local_file}{OFF}")

    merged = sources.get(args.id, sources.load())
    if merged and (merged.get("verified") or {}).get("method") == "unverified":
        print(f"{YELLOW}unverified{OFF} — nothing has called this endpoint yet. "
              f"Prove it: opp sources-check --id {args.id}")
    if merged and not sources.is_disabled(merged) and args.id not in scan.SCANNABLE:
        print(f"{DIM}registered, but `opp scan` cannot read it: no normaliser for this "
              f"payload shape. It counts as a known source and can be checked; turning it "
              f"into a scannable feed needs one added to scan.py.{OFF}")
    return 0


#: Fields a caller may never assert. `state` and `score` are *earned* — by
#: matching, and by a confirmation someone actually saw. A collector that could
#: post `state: applied` could write an application history that never happened,
#: which is the one thing this tool exists not to do.
EARNED_FIELDS = ("id", "fingerprint", "state", "state_reason", "score", "score_detail")


def cmd_add(args) -> int:
    """Take opportunities found by something other than `opp scan`.

    The scanners here read nine payload shapes. The web has thousands, most
    behind a login, and writing a parser per vendor does not converge. An agent
    with a browser already reads any of them — so the useful boundary is not
    "what can this program parse" but "what may enter the store, and under what
    checks". Rows arriving this way are held to exactly the checks a scanned row
    is: the same plausibility validator, the same fingerprint dedup, the same
    refusal to let a caller name its own state.
    """
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2

    if args.url or args.title:
        if not (args.url and args.title):
            print("one posting needs at least --url and --title", file=sys.stderr)
            return 2
        incoming = [{"url": args.url, "title": args.title, "org": args.org or "",
                     "description": args.description or "", "location": args.location or "",
                     "posted_at": args.posted or "", "opportunity_type": args.type or "employment"}]
    else:
        raw = sys.stdin.read()
        if not raw.strip():
            print("nothing on stdin — pipe a JSON object or array, or pass --url/--title",
                  file=sys.stderr)
            return 2
        try:
            payload = json.loads(raw)
        except ValueError as err:
            print(f"that is not JSON: {err}", file=sys.stderr)
            return 2
        incoming = payload if isinstance(payload, list) else [payload]

    con = store.connect(paths.db_path(workspace))
    outcomes = {"new": 0, "duplicate": 0, "known": 0}
    rejected: list[dict] = []
    asserted: set[str] = set()

    for item in incoming:
        if not isinstance(item, dict):
            rejected.append({"row": str(item)[:80], "why": "not an object"})
            continue
        row = {k: v for k, v in item.items() if k not in EARNED_FIELDS}
        asserted |= {k for k in item if k in EARNED_FIELDS}
        row.setdefault("source", args.source)
        # Provenance, not decoration: a row a person or an agent handed over did
        # not come from a verified feed, and six months later that difference is
        # the difference between a lead you can trust and one you cannot.
        row.setdefault("source_ref", "collected")
        why = scan.plausible(row)
        if why:
            rejected.append({"row": (row.get("title") or row.get("url") or "?")[:70], "why": why})
            continue
        outcomes[store.upsert(con, row)] += 1
    con.commit()

    if args.json:
        print(json.dumps({**outcomes, "rejected": rejected,
                          "ignored_fields": sorted(asserted)}, indent=2))
        return 0

    if asserted:
        print(f"{YELLOW}ignored{OFF} {', '.join(sorted(asserted))} — a row does not get to "
              f"declare its own state or score{OFF}")
    for bad_row in rejected:
        print(f"  {RED}rejected{OFF} {bad_row['why']:<28} {DIM}{bad_row['row']}{OFF}")
    print(f"\n{outcomes['new']} added, {outcomes['duplicate']} same job under another URL, "
          f"{outcomes['known']} already here"
          + (f", {len(rejected)} rejected" if rejected else ""))
    if outcomes["new"]:
        print(f"{DIM}next:  opp match --top 20{OFF}")
    return 0


def cmd_rules(args) -> int:
    """Read and change the workspace's hard rules.

    Editing config.json by hand still works and always will. This exists because
    the rules are the one thing a user changes mid-conversation ("actually, not
    the US"), and a typo in a knockout rule fails silently — it does not error,
    it just stops knocking things out.
    """
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2

    config_file = paths.config_path(workspace)
    config = paths.load_config(workspace)

    if not (args.set or args.add or args.remove):
        print(f"{config_file}\n")
        for key in paths.SETTABLE_RULES:
            value = config.get(key)
            shown = ", ".join(str(v) for v in value) if isinstance(value, list) else value
            print(f"  {key:<20} {shown if shown not in ('', [], None) else DIM + '(none)' + OFF}")
        print(f"\n  {DIM}{'auto_submit_requires':<20} read-only — "
              f"{len(config.get('auto_submit_requires', []))} conditions no setting waives{OFF}")
        print(f"\n{DIM}change one:  opp rules --set min_fit=0.55"
              f"\n             opp rules --add exclude_countries='united states'"
              f"\n             opp rules --remove exclude_countries='united states'{OFF}")
        return 0

    changed: list[str] = []
    for raw in (args.set or []):
        key, _, value = raw.partition("=")
        key = key.strip()
        try:
            config[key] = paths.coerce_rule(key, value.strip())
        except (KeyError, ValueError) as err:
            # KeyError stringifies to its repr, quotes and all — the message is
            # for a person to read, so take the message.
            print(f"{RED}{err.args[0] if err.args else err}{OFF}", file=sys.stderr)
            return 2
        changed.append(f"{key} = {config[key]}")

    for raw, removing in [(r, False) for r in (args.add or [])] + \
                         [(r, True) for r in (args.remove or [])]:
        key, _, value = raw.partition("=")
        key, value = key.strip(), value.strip()
        if key not in paths.LIST_RULES:
            print(f"{RED}{key} is not a list — use --set{OFF}", file=sys.stderr)
            return 2
        try:
            item = paths.coerce_rule_item(key, value)
        except ValueError as err:
            print(f"{RED}{err}{OFF}", file=sys.stderr)
            return 2
        current = list(config.get(key) or [])
        if removing:
            if item not in current:
                print(f"{DIM}{key} does not contain '{item}' — nothing to remove{OFF}")
                continue
            current.remove(item)
        elif item in current:
            print(f"{DIM}{key} already has '{item}'{OFF}")
            continue
        else:
            current.append(item)
        config[key] = current
        changed.append(f"{key} = {', '.join(current) or '(none)'}")

    if not changed:
        return 0
    # The `_`-prefixed keys are the file's own documentation; writing the merged
    # config back keeps them, so the file a person opens still explains itself.
    config_file.write_text(json.dumps(config, indent=2, ensure_ascii=False) + "\n")
    for line in changed:
        print(f"{GREEN}set{OFF} {line}")
    print(f"{DIM}→ {config_file}{OFF}")
    return 0


def cmd_sources_check(args) -> int:
    registry = sources.load()
    targets = ([sources.get(args.id, registry)] if args.id
               else sources.all_sources(registry))
    targets = [t for t in targets if t]
    if not targets:
        print(f"no such source: {args.id}", file=sys.stderr)
        return 2

    bad = 0
    for source in targets:
        result = sources.check(source, sample=args.sample, timeout=args.timeout)
        verdict = result["verdict"]
        colour = {"ok": GREEN, "http-error": RED, "unreachable": RED}.get(verdict, DIM)
        detail = result.get("note") or f"HTTP {result.get('status')} · {result.get('bytes')} bytes"
        print(f"  {colour}{verdict:<13}{OFF} {source['id']:<18} {detail}")
        if verdict in ("http-error", "unreachable"):
            bad += 1
    print(f"\n{len(targets)} checked, {bad} failing")
    return 1 if bad else 0


def cmd_scan(args) -> int:
    workspace = paths.find_workspace()
    if not workspace.exists():
        print("no workspace here — run: opp init", file=sys.stderr)
        return 2
    con = store.connect(paths.db_path(workspace))

    registry = sources.load()
    if args.source:
        wanted = [(args.source, args.target)]
    else:
        # Everything with a key-free feed that is not a per-company board. The
        # per-company ones need `--source greenhouse --target <company>`, because
        # "every Greenhouse board on earth" is not a thing anyone can enumerate.
        free_feeds = [s["id"] for s in sources.filter_sources(
            sources.all_sources(registry), free_only=True, no_key=True)
            if s["id"] in scan.SCANNABLE and not (s.get("access") or {}).get("per_company")]
        wanted = [(sid, None) for sid in free_feeds]

    totals = {"new": 0, "duplicate": 0, "known": 0}
    per_source: list[dict] = []
    for source_id, target in wanted:
        rows, report = scan.scan_source(source_id, target, limit=args.limit, registry=registry)
        outcomes = {"new": 0, "duplicate": 0, "known": 0}
        for row in rows:
            outcomes[store.upsert(con, row)] += 1
        for key in totals:
            totals[key] += outcomes[key]
        con.commit()
        store.record_scan(con, source=source_id, target=target or "",
                          status=report["status"], fetched=report.get("fetched", 0),
                          new_rows=outcomes["new"], duplicates=outcomes["duplicate"],
                          detail=report.get("detail", ""))
        con.commit()

        per_source.append({**report, **outcomes})
        if args.json:
            continue
        if report["status"] == "ok":
            line = (f"  {GREEN}ok{OFF}    {source_id:<16} {report['fetched']:>4} fetched  "
                    f"{outcomes['new']:>4} new  {outcomes['duplicate']:>3} dup  "
                    f"{outcomes['known']:>4} already seen")
            if report.get("rejected"):
                line += f"  {YELLOW}{report['rejected']} dropped{OFF}"
            print(line)
            # Never let a silent drop look like a quiet source.
            if report.get("rejected"):
                print(f"        {DIM}{report.get('detail', '')}{OFF}")
        else:
            print(f"  {RED}{report['status']}{OFF}  {source_id:<16} {report.get('detail', '')[:80]}")

    con.close()
    if args.json:
        print(json.dumps({**totals, "sources": per_source}, indent=2))
        return 0
    print(f"\n{totals['new']} new opportunit(ies), {totals['duplicate']} same job under another URL")
    if totals["new"]:
        print("next:  opp list --state new")
    return 0


def cmd_list(args) -> int:
    con = store.connect(paths.db_path())
    rows = store.search(con, state=args.state, source=args.source,
                        limit=args.limit, order=args.order)
    if args.json:
        print(store.dump(rows))
        return 0
    if not rows:
        print("nothing here yet — run: opp scan")
        return 0
    for row in rows:
        score = f"{row['score']:.2f}" if row["score"] is not None else "  – "
        remote = "remote" if row["remote"] else (row["location"] or "")[:22]
        print(f"  {row['id']}  {score}  {row['state']:<11} {(row['org'] or '?')[:26]:<26} "
              f"{row['title'][:44]:<44} {DIM}{remote}{OFF}")
    print(f"\n{len(rows)} shown · {DIM}opp show <id>{OFF}")
    con.close()
    return 0


def cmd_show(args) -> int:
    con = store.connect(paths.db_path())
    row = con.execute("SELECT * FROM opportunities WHERE id = ?", (args.id,)).fetchone()
    if row is None:
        print(f"no opportunity {args.id}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(dict(row), indent=2, ensure_ascii=False))
        return 0
    print(f"{row['title']}\n{row['org']}  ·  {row['location'] or '—'}  ·  {row['source']}")
    print(f"{row['url']}\n")
    print(f"state: {row['state']}   posted: {row['posted_at'] or '—'}")
    if row["salary_min"]:
        print(f"pay:   {row['salary_min']:.0f}–{row['salary_max'] or 0:.0f} "
              f"{row['salary_currency']} / {row['salary_period'] or '?'}")
    body = row["description"] or "(no description came with this posting)"
    print("\n" + (body if args.full else body[:1200] + ("…" if len(body) > 1200 else "")))
    con.close()
    return 0


def cmd_doctor(args) -> int:
    problems: list[str] = []
    state: dict = {}
    workspace = paths.find_workspace()
    say = (lambda *a, **k: None) if getattr(args, "json", False) else print
    state["workspace"], state["workspace_exists"] = str(workspace), workspace.exists()
    say(f"workspace: {workspace}{'' if workspace.exists() else '  (not created — run opp init)'}")
    if not workspace.exists():
        problems.append("no workspace")

    profile = paths.profile_path(workspace)
    state["profile"] = profile.exists()
    say(f"profile:   {'present' if profile.exists() else 'missing — scan works, match and apply do not'}")
    if not profile.exists():
        problems.append("no profile")

    registry = sources.load()
    allsrc = sources.all_sources(registry)
    free = [s for s in allsrc if sources.is_free(s)]
    scannable = [s for s in allsrc if s["id"] in scan.SCANNABLE]
    # `staleness` returns 0 for a row verified today, and `0 or default` is the
    # default — which reported every freshly-checked source as stale. Never test
    # a count for truthiness when zero is a meaningful answer.
    def is_stale(source) -> bool:
        age = sources.staleness(source)
        return age is None or age > sources.STALE_DAYS

    stale = [s for s in allsrc if is_stale(s)]
    state["sources"] = {"known": len(allsrc), "free": len(free),
                        "scannable": len(scannable), "stale": len(stale),
                        "scannable_ids": [s["id"] for s in scannable]}
    say(f"sources:   {len(allsrc)} known · {len(free)} free · {len(scannable)} directly scannable")
    if stale:
        say(f"           {YELLOW}{len(stale)} row(s) unverified for over {sources.STALE_DAYS} days"
              f"{OFF} — re-check with: opp sources check")

    if workspace.exists():
        con = store.connect(paths.db_path(workspace))
        counts = store.counts(con)
        total = sum(counts.values())
        state["store"] = {"total": total, "by_state": dict(sorted(counts.items()))}
        say(f"store:     {total} opportunit(ies) " +
              (", ".join(f"{k}={v}" for k, v in sorted(counts.items())) if counts else ""))
        con.close()

    state["problems"] = problems
    state["ready"] = not problems
    if getattr(args, "json", False):
        print(json.dumps(state, indent=2))
        return 1 if problems else 0
    if problems:
        print(f"\n{YELLOW}not ready:{OFF} " + ", ".join(problems))
        return 1
    print(f"\n{GREEN}ready{OFF}")
    return 0


# --------------------------------------------------------------------------- #

def main() -> int:
    parser = argparse.ArgumentParser(prog="opp", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"opportunity-engine {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="make a workspace here")
    p.add_argument("path", nargs="?")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("ingest", help="fold a CV, a resume.json or any document into your profile")
    p.add_argument("files", nargs="+")
    p.set_defaults(func=cmd_ingest)

    p = sub.add_parser("profile", help="what your profile can claim, and what is missing")
    p.add_argument("--agent", action="store_true",
                   help="print a prompt for a Claude session to complete it (no API call)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_profile)

    p = sub.add_parser("match", help="score opportunities against your profile, with evidence")
    p.add_argument("--id", help="one opportunity")
    p.add_argument("--top", type=int, default=10, help="how many to print")
    p.add_argument("--scan-limit", type=int, default=300, help="how many to score")
    p.add_argument("--verbose", "-v", action="store_true", help="show the evidence per requirement")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_match)

    p = sub.add_parser("cv", help="build a parser-safe CV from your profile")
    p.add_argument("--for", dest="for_id", help="tailor the ORDER for one opportunity id")
    p.add_argument("--variant", default="ats")
    p.add_argument("--out", help="output directory (default: the workspace)")
    p.add_argument("--no-pdf", action="store_true", help="write .tex only")
    p.set_defaults(func=cmd_cv)

    p = sub.add_parser("apply", help="assemble application packages (it never submits)")
    p.add_argument("--id", help="one opportunity")
    p.add_argument("--top", type=int, default=5, help="how many of the best matches")
    p.add_argument("--force", action="store_true",
                   help="prepare even a knocked-out or low-fit role")
    p.add_argument("--no-pdf", action="store_true")
    p.add_argument("--fleet", action="store_true",
                   help="also queue each package for agent-fleet, so many get filled "
                        "in parallel")
    p.add_argument("--auto-submit", dest="auto_submit", action="store_true", default=None,
                   help="let workers press submit on packages that qualify "
                        "(overrides auto_submit in your config)")
    p.add_argument("--no-auto-submit", dest="auto_submit", action="store_false",
                   help="fill and stop, whatever the config says")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("inbox", help="find email confirmations for applications already sent")
    p.add_argument("--days", type=int, default=inbox_mod.DEFAULT_WINDOW_DAYS,
                   help="how far back to look (default: %(default)s)")
    p.add_argument("--fleet", action="store_true",
                   help="queue one reconciler in the agent lane — no terminal, no Chrome tab")
    p.set_defaults(func=cmd_inbox)

    p = sub.add_parser("applied", help="record a submission you actually made")
    p.add_argument("id")
    p.add_argument("--evidence", required=True,
                   help="the confirmation the system returned — required, and not a formality")
    p.add_argument("--blocked", action="store_true", help="record a wall instead of a submission")
    p.set_defaults(func=cmd_applied)

    p = sub.add_parser("add", help="take opportunities an agent or a person found, from JSON")
    p.add_argument("--source", default="agent",
                   help="where it came from, for provenance (default: %(default)s)")
    p.add_argument("--url", help="one posting: the page to apply through")
    p.add_argument("--title")
    p.add_argument("--org")
    p.add_argument("--location")
    p.add_argument("--description")
    p.add_argument("--posted", help="ISO date the posting went up")
    p.add_argument("--type", help="employment, contract, freelance, grant, …")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("sources", help="where opportunities can be found, and what each costs")
    p.add_argument("--free-only", action="store_true", help="only what needs no card")
    p.add_argument("--no-key", action="store_true", help="only what needs no API key")
    p.add_argument("--kind")
    p.add_argument("--region")
    p.add_argument("--type", help="employment, freelance, contract, grant, …")
    p.add_argument("--automatable", action="store_true")
    p.add_argument("--local", action="store_true", help="only rows you added or patched")
    p.add_argument("--long", "-l", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_sources)

    p = sub.add_parser("sources-add",
                       help="add a source, patch a shipped one, or mute one — in your workspace")
    p.add_argument("--id", required=True, help="the source id: new one, or one that ships")
    p.add_argument("--name", help="human name")
    p.add_argument("--endpoint", help="URL; {n} = the scan limit, {board} = the --target company")
    p.add_argument("--kind", help="aggregator, ats-board, job-board, freelance-marketplace, …")
    p.add_argument("--per-company", action="store_true",
                   help="endpoint is one company's board; needs --target when scanning")
    p.add_argument("--max-rows", type=int, help="clamp --limit for a feed that degrades above it")
    p.add_argument("--note", help="why this one is worth having")
    p.add_argument("--disable", action="store_true", help="mute it without deleting it")
    p.add_argument("--enable", action="store_true", help="un-mute it")
    p.add_argument("--remove", action="store_true", help="drop YOUR entry (shipped rows return)")
    p.set_defaults(func=cmd_sources_add)

    p = sub.add_parser("rules", help="your hard limits — show them, or change one")
    p.add_argument("--set", action="append", metavar="KEY=VALUE",
                   help="e.g. min_fit=0.55, auto_submit=false")
    p.add_argument("--add", action="append", metavar="KEY=VALUE",
                   help="append to a list rule, e.g. exclude_countries='united states'")
    p.add_argument("--remove", action="append", metavar="KEY=VALUE",
                   help="drop one member of a list rule")
    p.set_defaults(func=cmd_rules)

    p = sub.add_parser("sources-check", help="re-verify sources by actually calling them")
    p.add_argument("--id")
    p.add_argument("--sample", help="company slug for a per-company board")
    p.add_argument("--timeout", type=int, default=30)
    p.set_defaults(func=cmd_sources_check)

    p = sub.add_parser("scan", help="pull opportunities from the key-free sources")
    p.add_argument("--source", help="one source id (default: every key-free feed)")
    p.add_argument("--target", help="company slug, for a per-company board")
    p.add_argument("--limit", type=int, default=200)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_scan)

    p = sub.add_parser("list", help="what is in the workspace")
    p.add_argument("--state", help=f"one of: {', '.join(store.STATES)}")
    p.add_argument("--source")
    p.add_argument("--limit", type=int, default=40)
    p.add_argument("--order", default="score", choices=("score", "date", "org"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show", help="one opportunity in full")
    p.add_argument("id")
    p.add_argument("--full", action="store_true")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("doctor", help="is this set up to actually work")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_doctor)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
